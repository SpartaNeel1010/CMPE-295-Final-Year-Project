# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewramp

# Secret used to sign JWTs – change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Port the FastAPI server listens on
PORT=4000

# Allowed CORS origin (your Next.js dev server)
CLIENT_ORIGIN=http://localhost:3000
